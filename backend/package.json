{
  "name": "game-playz-worker",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute game-playz-db --local --file=./schemas/schema.sql",
    "db:remote": "wrangler d1 execute game-playz-db --remote --file=./schemas/schema.sql",
    "words:build": "node scripts/build-words-sql.mjs",
    "words:local": "wrangler d1 execute game-playz-db --local --file=./schemas/words.sql",
    "words:remote": "wrangler d1 execute game-playz-db --remote --file=./schemas/words.sql"
  },
  "devDependencies": {
    "wrangler": "^4.137.0",
    "an-array-of-english-words": "^2.0.0"
  },
  "private": true
}
