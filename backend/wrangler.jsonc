{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "game-playz",
	"main": "src/index.js",
	"compatibility_date": "2026-09-23",

	// The website itself lives on Cloudflare Pages, so this Worker only
	// answers /api and /ws.
	//
	// CLIENT_ORIGIN: which website may talk to this Worker. Put your Pages
	// address here (no trailing slash) after your first Pages deploy.
	// Leave it empty to allow any website (fine while you are testing).
	"vars": {
		"CLIENT_ORIGIN": ""
	},

	// D1 = the SQL database. Rooms, players and the Word Chain dictionary.
	// Create it once with:  npx wrangler d1 create game-playz-db
	// then paste the id it prints below.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "game-playz-db",
			"database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
		}
	],

	// One Durable Object per room: it holds the WebSocket connections and
	// the live game. This is what replaces the old Socket.IO server.
	"durable_objects": {
		"bindings": [{ "name": "ROOM", "class_name": "GameRoom" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],

	"observability": { "enabled": true }
}
