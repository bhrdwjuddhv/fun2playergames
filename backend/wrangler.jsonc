{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "game-playz",
	"main": "src/index.js",
	"compatibility_date": "2026-09-23",

	// The website itself lives on Cloudflare Pages, so this Worker only
	// answers /api and /ws.
	//
	// CLIENT_ORIGIN: which website may talk to this Worker. Put your Pages
	// address here (no trailing slash) after your first Pages deploy.
	// Leave it empty to allow any website (fine while you are testing).
	"vars": {
		"CLIENT_ORIGIN": ""
	},

	// D1 = the SQL database (rooms and players).
	//
	// There is no "database_id" here on purpose: it is not committed to
	// GitHub. Cloudflare puts it in during the build, from the build variable
	// D1_DATABASE_ID (see scripts/build-config.mjs and DEPLOY.md).
	// Local development does not need it — wrangler makes its own local copy.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "game-playz-db"
		}
	],

	// One Durable Object per room: it holds the WebSocket connections and
	// the live game. This is what replaces the old Socket.IO server.
	"durable_objects": {
		"bindings": [{ "name": "ROOM", "class_name": "GameRoom" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],

	"observability": { "enabled": true }
}
