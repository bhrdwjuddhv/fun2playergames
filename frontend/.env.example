# Where the backend Worker lives.
#
# Leave this EMPTY for local development: Vite forwards /api and /ws to the
# Worker at http://localhost:8787 (see vite.config.js).
#
# On Cloudflare Pages, set this in the project's build settings
# (Settings → Variables and Secrets → Variables) to your Worker address:
# VITE_SERVER_URL=https://game-playz.<your-subdomain>.workers.dev
VITE_SERVER_URL=
